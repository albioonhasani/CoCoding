{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "server/ai/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/challenges", "destination": "/index.html" },
    { "source": "/roadmaps", "destination": "/index.html" },
    { "source": "/roadmaps/:roadmapId", "destination": "/index.html" },
    { "source": "/resources", "destination": "/index.html" },
    { "source": "/progress", "destination": "/index.html" }
  ]
}
